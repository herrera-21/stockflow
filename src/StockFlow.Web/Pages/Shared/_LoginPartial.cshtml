@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject IStringLocalizer<SharedResource> Localizer

@if (SignInManager.IsSignedIn(User))
{
    <span class="app-user">@Localizer["WelcomeUser", UserManager.GetUserName(User) ?? string.Empty]</span>
    <form asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index")" method="post" class="d-inline">
        <button type="submit" class="btn btn-link app-header-link">@Localizer["Logout"]</button>
    </form>
}
else
{
    <a class="app-header-link" asp-page="/Account/Login">@Localizer["Login"]</a>
}
