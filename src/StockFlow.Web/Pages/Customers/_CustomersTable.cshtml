@model StockFlow.Web.Pages.Customers.IndexModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@if (Model.Customers.Items.Count == 0)
{
    <div class="alert alert-info" role="alert">@Localizer["EmptyCustomers"]</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th scope="col">@Localizer["Name"]</th>
                <th scope="col">@Localizer["TaxId"]</th>
                <th scope="col">@Localizer["Phone"]</th>
                <th scope="col">@Localizer["Email"]</th>
                <th scope="col">@Localizer["Status"]</th>
                <th scope="col" class="text-end">@Localizer["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in Model.Customers.Items)
            {
                <partial name="_CustomerRow" model="new CustomerRowViewModel(customer, Model.PageNumber, Model.Search)" />
            }
        </tbody>
    </table>

    @if (Model.Customers.TotalPages > 1)
    {
        <nav aria-label="@Localizer["CustomersTitle"]">
            <ul class="pagination">
                <li class="page-item @(Model.Customers.HasPreviousPage ? string.Empty : "disabled")">
                    <a class="page-link"
                       href="@Url.Page("/Customers/Index", null, new { pageNumber = Model.PageNumber - 1, search = Model.Search })"
                       hx-get="@Url.Page("/Customers/Index", "Rows", new { pageNumber = Model.PageNumber - 1, search = Model.Search })"
                       hx-target="#customers-container"
                       hx-swap="innerHTML">@Localizer["Previous"]</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">@Localizer["PageOf", Model.PageNumber, Model.Customers.TotalPages]</span>
                </li>
                <li class="page-item @(Model.Customers.HasNextPage ? string.Empty : "disabled")">
                    <a class="page-link"
                       href="@Url.Page("/Customers/Index", null, new { pageNumber = Model.PageNumber + 1, search = Model.Search })"
                       hx-get="@Url.Page("/Customers/Index", "Rows", new { pageNumber = Model.PageNumber + 1, search = Model.Search })"
                       hx-target="#customers-container"
                       hx-swap="innerHTML">@Localizer["Next"]</a>
                </li>
            </ul>
        </nav>
    }
}
