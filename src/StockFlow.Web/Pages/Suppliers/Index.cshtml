@page
@model StockFlow.Web.Pages.Suppliers.IndexModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["SuppliersTitle"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Localizer["SuppliersTitle"]</h1>
    <a asp-page="Create" class="btn btn-primary">@Localizer["NewSupplier"]</a>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-8">
        <input type="search" id="supplier-search" name="search" value="@Model.Search" class="form-control"
               placeholder="@Localizer["SearchSuppliersPlaceholder"]"
               hx-get="@Url.Page("/Suppliers/Index", "Rows")"
               hx-trigger="keyup changed delay:300ms, search"
               hx-target="#suppliers-container"
               hx-swap="innerHTML" />
    </div>
</div>

<div id="suppliers-container">
    <partial name="_SuppliersTable" model="Model" />
</div>
