@page
@model StockFlow.Web.Pages.Products.CreateModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["CreateProductTitle"];
}

<h1>@Localizer["CreateProductTitle"]</h1>

<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.Sku" class="form-label"></label>
                    <input asp-for="Input.Sku" class="form-control" placeholder="@Localizer["SkuPlaceholder"]" />
                    <div class="form-text">@Localizer["SkuHelp"]</div>
                    <span asp-validation-for="Input.Sku" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.Name" class="form-label"></label>
                    <input asp-for="Input.Name" class="form-control" />
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Description" class="form-label"></label>
                <textarea asp-for="Input.Description" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Input.Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.CategoryId" class="form-label"></label>
                <select asp-for="Input.CategoryId" asp-items="Model.Categories" class="form-select js-searchable" data-no-results="@Localizer["NoResults"]">
                    <option value="">@Localizer["SelectCategory"]</option>
                </select>
                <span asp-validation-for="Input.CategoryId" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.BaseUnit" class="form-label"></label>
                    <select asp-for="Input.BaseUnit" asp-items="Model.Units" class="form-select"></select>
                    <div class="form-text">@Localizer["BaseUnitHelp"]</div>
                    <span asp-validation-for="Input.BaseUnit" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.PurchaseUnit" class="form-label"></label>
                    <select asp-for="Input.PurchaseUnit" asp-items="Model.Units" class="form-select"></select>
                    <div class="form-text">@Localizer["PurchaseUnitHelp"]</div>
                    <span asp-validation-for="Input.PurchaseUnit" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.PurchaseUnitFactor" class="form-label"></label>
                    <input asp-for="Input.PurchaseUnitFactor" class="form-control js-numeric" type="text" inputmode="decimal" placeholder="1" />
                    <div class="form-text">@Localizer["PurchaseUnitFactorHelp"]</div>
                    <span asp-validation-for="Input.PurchaseUnitFactor" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.PurchasePrice" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">@Localizer["CurrencySymbol"]</span>
                        <input asp-for="Input.PurchasePrice" class="form-control js-numeric" type="text" inputmode="decimal" placeholder="0.00" />
                    </div>
                    <div class="form-text">@Localizer["PurchasePriceHelp"]</div>
                    <div class="alert alert-info py-1 px-2 small mt-2 mb-0" id="unit-cost-hint" role="status" aria-live="polite"
                         data-template="@Localizer["UnitCostHint"]" data-currency="@Localizer["CurrencySymbol"]" hidden></div>
                    <span asp-validation-for="Input.PurchasePrice" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.SalePrice" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">@Localizer["CurrencySymbol"]</span>
                        <input asp-for="Input.SalePrice" class="form-control js-numeric" type="text" inputmode="decimal" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="Input.SalePrice" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.TaxRate" class="form-label"></label>
                    <input asp-for="Input.TaxRate" class="form-control js-numeric" type="text" inputmode="decimal" placeholder="0.00" />
                    <span asp-validation-for="Input.TaxRate" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.InitialStock" class="form-label"></label>
                    <input asp-for="Input.InitialStock" class="form-control js-numeric" type="text" inputmode="decimal" placeholder="0" />
                    <span asp-validation-for="Input.InitialStock" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.MinimumStock" class="form-label"></label>
                    <input asp-for="Input.MinimumStock" class="form-control js-numeric" type="text" inputmode="decimal" placeholder="0" />
                    <span asp-validation-for="Input.MinimumStock" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
            <a asp-page="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
