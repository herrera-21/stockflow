@using Microsoft.Extensions.Localization
@using StockFlow.Domain
@inject IStringLocalizer<SharedResource> Localizer
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StockFlow</title>
    <script type="importmap"></script>
    <script>
        // Applies the remembered sidebar state before first paint to avoid a flash of the wrong
        // layout. Kept inline and minimal because site.js loads at the end of the body.
        (function () {
            try {
                if (window.localStorage.getItem('stockflow.sidebar') === 'collapsed') {
                    document.documentElement.classList.add('app-sidebar-collapsed');
                }
            } catch (error) {
                // localStorage can be unavailable (for example in private mode): stay expanded.
            }
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/tom-select/tom-select.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-shell">
    <header class="app-header" data-bs-theme="dark">
        <button class="app-sidebar-toggle" type="button" aria-label="@Localizer["ToggleNavigation"]"
                aria-controls="appSidebar" aria-expanded="true" data-sidebar-toggle
                data-label-collapse="@Localizer["CollapseNavigation"]"
                data-label-expand="@Localizer["ExpandNavigation"]">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M3 6h18M3 12h18M3 18h18" />
            </svg>
        </button>
        <a class="app-brand" asp-area="" asp-page="/Products/Index">
            <span class="app-brand-mark" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 7l9-4 9 4v10l-9 4-9-4V7z" />
                    <path d="M3 7l9 4 9-4M12 11v10" />
                </svg>
            </span>
            <span>StockFlow</span>
        </a>
        <div class="ms-auto d-flex align-items-center gap-3">
            <partial name="_LanguageSelector" />
            <partial name="_LoginPartial" />
        </div>
    </header>

    <aside class="app-sidebar" id="appSidebar" data-bs-theme="dark">
        @{
            // Link visibility per role; a section is rendered only when it has at least one link.
            var canSeeProducts = User.Identity?.IsAuthenticated == true;
            var canSeeCategories = User.IsInRole(ApplicationRoles.Administrator);
            var canSeeCustomers = User.IsInRole(ApplicationRoles.Administrator) || User.IsInRole(ApplicationRoles.Salesperson);
            var canSeeSuppliers = User.IsInRole(ApplicationRoles.Administrator) || User.IsInRole(ApplicationRoles.InventoryManager);
        }
        <nav class="app-nav" aria-label="@Localizer["MainNavigation"]">
            @if (canSeeProducts || canSeeCategories)
            {
                <div class="app-nav-section" role="group" aria-labelledby="nav-section-inventory">
                    <div class="app-nav-heading" id="nav-section-inventory">@Localizer["NavSectionInventory"]</div>
                    @if (canSeeProducts)
                    {
                        <a class="nav-link app-nav-link @(IsActive("/Products") ? "active" : "")"
                           asp-area="" asp-page="/Products/Index"
                           aria-current="@(IsActive("/Products") ? "page" : null)"
                           title="@Localizer["NavProducts"]">
                            <svg class="app-nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 7l9-4 9 4v10l-9 4-9-4V7z" />
                                <path d="M3 7l9 4 9-4M12 11v10" />
                            </svg>
                            <span class="app-nav-label">@Localizer["NavProducts"]</span>
                        </a>
                    }
                    @if (canSeeCategories)
                    {
                        <a class="nav-link app-nav-link @(IsActive("/Categories") ? "active" : "")"
                           asp-area="" asp-page="/Categories/Index"
                           aria-current="@(IsActive("/Categories") ? "page" : null)"
                           title="@Localizer["NavCategories"]">
                            <svg class="app-nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M4 4h7l9 9-7 7-9-9V4z" />
                                <circle cx="8.5" cy="8.5" r="1.2" />
                            </svg>
                            <span class="app-nav-label">@Localizer["NavCategories"]</span>
                        </a>
                    }
                </div>
            }
            @if (canSeeCustomers || canSeeSuppliers)
            {
                <div class="app-nav-section" role="group" aria-labelledby="nav-section-commercial">
                    <div class="app-nav-heading" id="nav-section-commercial">@Localizer["NavSectionCommercial"]</div>
                    @if (canSeeCustomers)
                    {
                        <a class="nav-link app-nav-link @(IsActive("/Customers") ? "active" : "")"
                           asp-area="" asp-page="/Customers/Index"
                           aria-current="@(IsActive("/Customers") ? "page" : null)"
                           title="@Localizer["NavCustomers"]">
                            <svg class="app-nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="9" cy="8" r="3" />
                                <path d="M3 20a6 6 0 0 1 12 0" />
                                <path d="M16 6a3 3 0 0 1 0 6M18 20a6 6 0 0 0-3-5.2" />
                            </svg>
                            <span class="app-nav-label">@Localizer["NavCustomers"]</span>
                        </a>
                    }
                    @if (canSeeSuppliers)
                    {
                        <a class="nav-link app-nav-link @(IsActive("/Suppliers") ? "active" : "")"
                           asp-area="" asp-page="/Suppliers/Index"
                           aria-current="@(IsActive("/Suppliers") ? "page" : null)"
                           title="@Localizer["NavSuppliers"]">
                            <svg class="app-nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 7h10v9H3z" />
                                <path d="M13 10h4l3 3v3h-7z" />
                                <circle cx="7" cy="18" r="1.6" />
                                <circle cx="17" cy="18" r="1.6" />
                            </svg>
                            <span class="app-nav-label">@Localizer["NavSuppliers"]</span>
                        </a>
                    }
                </div>
            }
        </nav>
    </aside>

    <div class="app-sidebar-backdrop" data-sidebar-backdrop></div>

    <div class="app-content">
        <main role="main" class="app-main">
            @if (TempData["StatusMessage"] is string statusMessage)
            {
                <div class="alert alert-success alert-dismissible fade show js-auto-dismiss" role="alert">
                    @statusMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer["Close"]"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] is string errorMessage)
            {
                <div class="alert alert-danger alert-dismissible fade show js-auto-dismiss" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer["Close"]"></button>
                </div>
            }
            @RenderBody()
        </main>

        <footer class="app-footer text-muted">
            &copy; 2026 - StockFlow
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/htmx/htmx.min.js"></script>
    <script src="~/lib/tom-select/tom-select.complete.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    // True when the current Razor Page path starts with the given prefix, used for the active link.
    private bool IsActive(string prefix)
    {
        var page = ViewContext.RouteData.Values["page"] as string;
        return page is not null && page.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
    }
}
